# =============================================================================
# EcoBuild AI — Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# .env is gitignored and must NEVER be committed to version control.
# =============================================================================

# ── MongoDB Connection ────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── JWT Auth ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-secret-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Seed Script Credentials (only needed when running seed/seed_auth.py) ─────
# Override these with strong passwords before seeding a production database.
# In local dev the seed script falls back to the defaults shown in seed_auth.py.
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ARCHITECT_A_PASSWORD=Architect@12345
SEED_ARCHITECT_B_PASSWORD=Builder@12345
SEED_CUSTOMER_A_PASSWORD=Customer@12345
SEED_CUSTOMER_B_PASSWORD=Customer@12345
